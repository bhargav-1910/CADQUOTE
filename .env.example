# ForgeQuote environment configuration
# Copy to .env and replace every placeholder. Never commit the real .env.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=production          # "development" | "production"
DEBUG=false                     # MUST be false in production (startup refuses otherwise)
APP_NAME=ForgeQuote

# ---------------------------------------------------------------------------
# Database (used by docker-compose to provision Postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=quote_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=quote_db
# The application should connect as a least-privilege role that owns only the
# application schema — never as the Postgres superuser.
# DATABASE_URL=postgresql+asyncpg://app_user:password@postgres:5432/quote_db
DATABASE_POOL_SIZE=10
AUTO_CREATE_TABLES=false        # migrations own the schema in production

REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Minimum 32 characters in production; startup fails on the default value.
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Session lifetimes
SESSION_IDLE_TIMEOUT_MINUTES=10080     # 7 days of inactivity ends the session
SESSION_ABSOLUTE_TIMEOUT_HOURS=720     # 30 days maximum session lifetime

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_DEPTH=5
BCRYPT_ROUNDS=12

# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_CAPTCHA_AFTER_FAILURES=3
RATE_LIMIT_ENABLED=true

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_PER_HOUR=5

# Comma-separated addresses RESERVED from public registration, so nobody can
# claim your own address on a fresh deployment. This does NOT grant anything.
# The admin role is granted out of band, after the operator has signed up:
#   docker compose exec backend python -m app.manage grant-admin you@example.com
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Transport and hosting
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=https://app.example.com
# Explicit origins only — "*" with credentials is rejected at startup.
CORS_ORIGINS=["https://app.example.com"]
# Comma-separated Host header allowlist, or "*" to disable the check.
ALLOWED_HOSTS=app.example.com
FORCE_HTTPS=true
HSTS_MAX_AGE_SECONDS=63072000
MAX_REQUEST_BODY_MB=110

# ---------------------------------------------------------------------------
# Outbound email (password reset). Without SMTP_HOST, mail is logged, not sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=ForgeQuote

# ---------------------------------------------------------------------------
# Legal / compliance identity (rendered into the policy pages and security.txt)
# ---------------------------------------------------------------------------
LEGAL_COMPANY_NAME=ForgeQuote
LEGAL_CONTACT_EMAIL=support@example.com
LEGAL_PRIVACY_EMAIL=privacy@example.com
LEGAL_SECURITY_EMAIL=security@example.com
LEGAL_COMPANY_ADDRESS=Your registered address, City, Country
LEGAL_JURISDICTION=India
LEGAL_POLICY_VERSION=2026-07-30
LEGAL_DATA_RETENTION_DAYS=730

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
STORAGE_TYPE=local              # "local" or "s3"
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Billing (Stripe). Without STRIPE_WEBHOOK_SECRET the webhook is refused in
# production — an unsigned webhook is an unauthenticated "credit my wallet".
# ---------------------------------------------------------------------------
POINTS_SYSTEM_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=inr

# ---------------------------------------------------------------------------
# Column encryption (GSTIN, customer phone). Unset = plaintext, as before.
# Generate:  python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# BACK THIS UP SEPARATELY FROM THE DATABASE. Lose it and those columns are
# unreadable forever.
# ---------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Password hashing (Argon2id). Raise ARGON2_MEMORY_KIB on hosts with headroom.
# ---------------------------------------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_TTL_HOURS=48
# The admin role stays inert until the address is confirmed.
REQUIRE_VERIFIED_EMAIL_FOR_ADMIN=true

# ---------------------------------------------------------------------------
# Malware scanning of uploads (optional). Point at a clamd instance.
# ---------------------------------------------------------------------------
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
# Refuse uploads while the scanner is down (correct for untrusted intake).
CLAMAV_FAIL_CLOSED=true
