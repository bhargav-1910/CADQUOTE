# Environment configuration for CNC Quote Platform
# Copy this file to .env and update values as needed

# Application
APP_NAME="CNC Quote Platform"
APP_VERSION="1.0.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cncquote

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# S3 Configuration (optional, for production)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Pricing Configuration
DEFAULT_MARGIN_FACTOR=1.25
DEFAULT_HOURLY_MACHINE_RATE=85.0
DEFAULT_MACHINE_EFFICIENCY=0.75

# Quote Settings
QUOTE_VALIDITY_DAYS=14

FRONTEND_BASE_URL=http://localhost:5173

# Stripe Billing
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_CURRENCY=inr

# Points Costs
POINTS_COST_UPLOAD_FILE=2
POINTS_COST_TRIGGER_PROCESSING=3
POINTS_COST_CREATE_QUOTE=8
POINTS_COST_SEND_QUOTE_EMAIL=2
POINTS_STARTING_BONUS=200

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Auth — REQUIRED in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
